{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-G",
                "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_C_COMPILER=D:/tools/arm-gnu-toolchain/14.3 rel1/bin/arm-none-eabi-gcc.exe",
                "-DCMAKE_CXX_COMPILER=D:/tools/arm-gnu-toolchain/14.3 rel1/bin/arm-none-eabi-g++.exe",
                "-DCMAKE_ASM_COMPILER=arm-none-eabi-gcc",
                "-DCMAKE_OBJCOPY=arm-none-eabi-objcopy",
                "-DCMAKE_OBJDUMP=arm-none-eabi-objdump",
                "-DCMAKE_AR=arm-none-eabi-ar"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Configure CMake project with Ninja generator"
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--config",
                "Debug",
                "-j4"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Build the project"
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean build directory"
        },
        {
            "label": "CMake: Rebuild",
            "type": "shell",
            "dependsOn": [
                "CMake: Clean",
                "CMake: Build"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Clean and rebuild the project"
        },
        {
            "label": "Generate HEX and BIN",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "dart_mcu.elf"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Generate HEX and BIN files from ELF"
        },
        {
            "label": "OpenOCD: Flash",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "${workspaceFolder}/stlink.cfg",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "program ${workspaceFolder}/build/dart_mcu.elf verify reset exit"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Flash the firmware using OpenOCD"
        },
        {
            "label": "OpenOCD: Flash BIN",
            "type": "shell",
            "command": "openocd",
            "args": [
                "-f",
                "${workspaceFolder}/stlink.cfg",
                "-f",
                "target/stm32f4x.cfg",
                "-c",
                "program ${workspaceFolder}/build/dart_mcu.bin verify reset exit 0x08000000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "detail": "Flash the BIN file using OpenOCD"
        }
    ]
}
