{
    "cmake.configureOnOpen": true,
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.installPrefix": "${workspaceFolder}/build",
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.generator": "Ninja",
    "cmake.buildBeforeRun": true,
    "cmake.clearOutputBeforeBuild": true,
    "cmake.configureSettings": {
        "CMAKE_TOOLCHAIN_FILE": "",
        "CMAKE_C_COMPILER": "D:/tools/arm-gnu-toolchain/14.3 rel1/bin/arm-none-eabi-gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/tools/arm-gnu-toolchain/14.3 rel1/bin/arm-none-eabi-g++.exe",
        "CMAKE_ASM_COMPILER": "arm-none-eabi-gcc",
        "CMAKE_OBJCOPY": "arm-none-eabi-objcopy",
        "CMAKE_OBJDUMP": "arm-none-eabi-objdump",
        "CMAKE_SIZE": "arm-none-eabi-size",
        "CMAKE_AR": "arm-none-eabi-ar"
    },
    "cmake.configureArgs": [
        "-DCMAKE_ASM_COMPILER=arm-none-eabi-gcc",
        "-DCMAKE_OBJCOPY=arm-none-eabi-objcopy",
        "-DCMAKE_OBJDUMP=arm-none-eabi-objdump",
        "-DCMAKE_AR=arm-none-eabi-ar"
    ],
    "cmake.buildArgs": [
        "-j4"
    ],
    "cmake.cmakePath": "cmake",
    "cmake.preferredGenerators": [
        "Ninja"
    ],
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
        "*.s": "assembly",
        "*.ld": "linkerscript"
    },
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "stm32cube-ide-clangd.path": "cube",
    "stm32cube-ide-clangd.arguments": [
        "starm-clangd",
        "--query-driver=D:/tools/arm-gnu-toolchain/14.3 rel1/bin/arm-none-eabi-gcc.exe",
        "--query-driver=D:/tools/arm-gnu-toolchain/14.3 rel1/bin/arm-none-eabi-g++.exe"
    ]
}
